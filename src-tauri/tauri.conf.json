{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HybridChat",
  "version": "0.1.0",
  "identifier": "com.hybridagent.hybridchat",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HybridChat",
        "width": 1080,
        "height": 760,
        "minWidth": 700,
        "minHeight": 520,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A local HybridAgent chat client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
